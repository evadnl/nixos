    // Autostart
    spawn-at-startup "noctalia"
    spawn-at-startup "blueman-applet"
    spawn-at-startup "vesktop"
    spawn-at-startup "1password" "--silent"
    spawn-at-startup "steam" "-silent"
    // wl-mirror (ASUS -> capture card) is spawned from config.kdl: it must resolve
    // the ASUS's connector at launch because wl-mirror can only name the source by
    // connector, and connector names reshuffle between cold boots.
