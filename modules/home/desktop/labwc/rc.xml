<?xml version="1.0"?>
<labwc_config>

  <core>
    <decoration>server</decoration>
    <gap>8</gap>
    <adaptiveSync>fullscreen</adaptiveSync>
  </core>

  <placement>
    <policy>cascade</policy>
  </placement>

  <theme>
    <name>catppuccin-mocha-traffic</name>
    <icon>Papirus-Dark</icon>
    <titlebar>
      <layout>close,iconify,max:</layout>
      <showTitle>yes</showTitle>
    </titlebar>
    <cornerRadius>8</cornerRadius>
    <dropShadows>yes</dropShadows>
    <font>
      <name>JetBrainsMono Nerd Font Propo</name>
      <size>10</size>
    </font>
  </theme>

  <windowSwitcher preview="yes" outlines="yes">
    <osd show="yes" style="thumbnail" output="focused" />
  </windowSwitcher>

  <desktops number="5" />

  <snapping>
    <topMaximize>yes</topMaximize>
  </snapping>

  <regions>
    <region name="left-half" x="0%" y="0%" width="50%" height="100%" />
    <region name="right-half" x="50%" y="0%" width="50%" height="100%" />
    <region name="center-half" x="25%" y="0%" width="50%" height="100%" />
    <region name="full" x="0%" y="0%" width="100%" height="100%" />
    <region name="almost-full" x="5%" y="5%" width="90%" height="90%" />
    <region name="left-three-quarters" x="0%" y="0%" width="75%" height="100%" />
    <region name="right-three-quarters" x="25%" y="0%" width="75%" height="100%" />
    <region name="left-two-thirds" x="0%" y="0%" width="67%" height="100%" />
    <region name="right-two-thirds" x="33%" y="0%" width="67%" height="100%" />
    <region name="left-third" x="0%" y="0%" width="33%" height="100%" />
    <region name="right-third" x="67%" y="0%" width="33%" height="100%" />
    <region name="left-quarter" x="0%" y="0%" width="25%" height="100%" />
    <region name="right-quarter" x="75%" y="0%" width="25%" height="100%" />
  </regions>

  <keyboard>
    <numlock>on</numlock>
    <repeatRate>35</repeatRate>
    <repeatDelay>200</repeatDelay>

    <keybind key="C-A-S-W-Return"><action name="SnapToRegion" region="full" /></keybind>
    <keybind key="C-A-S-W-h"><action name="SnapToRegion" region="left-half" /></keybind>
    <keybind key="C-A-S-W-l"><action name="SnapToRegion" region="right-half" /></keybind>
    <keybind key="C-A-S-W-j"><action name="SnapToRegion" region="center-half" /></keybind>
    <keybind key="C-A-S-W-space"><action name="SnapToRegion" region="almost-full" /></keybind>
    <keybind key="C-A-S-W-k"><action name="SnapToRegion" region="almost-full" /></keybind>
    <keybind key="C-A-S-W-n"><action name="SnapToRegion" region="left-three-quarters" /></keybind>
    <keybind key="C-A-S-W-period"><action name="SnapToRegion" region="right-three-quarters" /></keybind>
    <keybind key="C-A-S-W-m"><action name="SnapToRegion" region="left-two-thirds" /></keybind>
    <keybind key="C-A-S-W-comma"><action name="SnapToRegion" region="right-two-thirds" /></keybind>
    <keybind key="C-A-S-W-y"><action name="SnapToRegion" region="left-third" /></keybind>
    <keybind key="C-A-S-W-o"><action name="SnapToRegion" region="right-third" /></keybind>
    <keybind key="C-A-S-W-u"><action name="SnapToRegion" region="left-quarter" /></keybind>
    <keybind key="C-A-S-W-i"><action name="SnapToRegion" region="right-quarter" /></keybind>
    <keybind key="C-A-S-W-equal"><action name="ResizeRelative" left="30" right="30" top="30" bottom="30" /></keybind>
    <keybind key="C-A-S-W-minus"><action name="ResizeRelative" left="-30" right="-30" top="-30" bottom="-30" /></keybind>
    <keybind key="C-A-S-W-p"><action name="NextWindow" identifier="current" /></keybind>
    <keybind key="C-A-S-W-Up"><action name="MoveToOutput" direction="up" /></keybind>
    <keybind key="C-A-S-W-Down"><action name="MoveToOutput" direction="down" /></keybind>
    <keybind key="C-A-S-W-b">
      <action name="Execute"><command>sh -c 'gtk-launch "$(xdg-settings get default-web-browser)"'</command></action>
    </keybind>
    <keybind key="C-A-S-W-c"><action name="Execute" command="code" /></keybind>

    <keybind key="W-Return"><action name="Execute" command="ghostty" /></keybind>
    <keybind key="W-C-Return"><action name="Execute" command="ghostty --class=com.mitchellh.ghostty-float" /></keybind>
    <keybind key="W-b">
      <action name="Execute"><command>sh -c 'gtk-launch "$(xdg-settings get default-web-browser)"'</command></action>
    </keybind>
    <keybind key="W-space"><action name="Execute" command="noctalia msg panel-toggle launcher" /></keybind>
    <keybind key="W-A-l"><action name="Execute" command="noctalia msg session lock" /></keybind>
    <keybind key="W-A-s" allowWhenLocked="yes">
      <action name="Execute"><command>sh -c 'pkill orca || exec orca'</command></action>
    </keybind>

    <keybind key="XF86AudioRaiseVolume" allowWhenLocked="yes"><action name="Execute" command="wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1+ -l 1.0" /></keybind>
    <keybind key="XF86AudioLowerVolume" allowWhenLocked="yes"><action name="Execute" command="wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1-" /></keybind>
    <keybind key="XF86AudioMute" allowWhenLocked="yes"><action name="Execute" command="wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle" /></keybind>
    <keybind key="XF86AudioMicMute" allowWhenLocked="yes"><action name="Execute" command="wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle" /></keybind>
    <keybind key="XF86AudioPlay" allowWhenLocked="yes"><action name="Execute" command="playerctl play-pause" /></keybind>
    <keybind key="XF86AudioStop" allowWhenLocked="yes"><action name="Execute" command="playerctl stop" /></keybind>
    <keybind key="XF86AudioPrev" allowWhenLocked="yes"><action name="Execute" command="playerctl previous" /></keybind>
    <keybind key="XF86AudioNext" allowWhenLocked="yes"><action name="Execute" command="playerctl next" /></keybind>
    <keybind key="XF86MonBrightnessUp" allowWhenLocked="yes"><action name="Execute" command="brightnessctl --class=backlight set +10%" /></keybind>
    <keybind key="XF86MonBrightnessDown" allowWhenLocked="yes"><action name="Execute" command="brightnessctl --class=backlight set 10%-" /></keybind>

    <keybind key="W-w"><action name="Close" /></keybind>
    <keybind key="W-m"><action name="Iconify" /></keybind>
    <keybind key="W-f"><action name="ToggleMaximize" /></keybind>
    <keybind key="W-S-f"><action name="ToggleFullscreen" /></keybind>
    <keybind key="W-c"><action name="AutoPlace" policy="center" /></keybind>

    <keybind key="W-C-h"><action name="MoveToEdge" direction="left" /></keybind>
    <keybind key="W-C-j"><action name="MoveToEdge" direction="down" /></keybind>
    <keybind key="W-C-k"><action name="MoveToEdge" direction="up" /></keybind>
    <keybind key="W-C-l"><action name="MoveToEdge" direction="right" /></keybind>
    <keybind key="W-C-Left"><action name="MoveToEdge" direction="left" /></keybind>
    <keybind key="W-C-Down"><action name="MoveToEdge" direction="down" /></keybind>
    <keybind key="W-C-Up"><action name="MoveToEdge" direction="up" /></keybind>
    <keybind key="W-C-Right"><action name="MoveToEdge" direction="right" /></keybind>
    <keybind key="W-S-h"><action name="FocusOutput" direction="left" /></keybind>
    <keybind key="W-S-j"><action name="FocusOutput" direction="down" /></keybind>
    <keybind key="W-S-k"><action name="FocusOutput" direction="up" /></keybind>
    <keybind key="W-S-l"><action name="FocusOutput" direction="right" /></keybind>
    <keybind key="W-S-Left"><action name="FocusOutput" direction="left" /></keybind>
    <keybind key="W-S-Down"><action name="FocusOutput" direction="down" /></keybind>
    <keybind key="W-S-Up"><action name="FocusOutput" direction="up" /></keybind>
    <keybind key="W-S-Right"><action name="FocusOutput" direction="right" /></keybind>
    <keybind key="W-S-C-h"><action name="MoveToOutput" direction="left" /></keybind>
    <keybind key="W-S-C-j"><action name="MoveToOutput" direction="down" /></keybind>
    <keybind key="W-S-C-k"><action name="MoveToOutput" direction="up" /></keybind>
    <keybind key="W-S-C-l"><action name="MoveToOutput" direction="right" /></keybind>
    <keybind key="W-S-C-Left"><action name="MoveToOutput" direction="left" /></keybind>
    <keybind key="W-S-C-Down"><action name="MoveToOutput" direction="down" /></keybind>
    <keybind key="W-S-C-Up"><action name="MoveToOutput" direction="up" /></keybind>
    <keybind key="W-S-C-Right"><action name="MoveToOutput" direction="right" /></keybind>

    <keybind key="W-1"><action name="GoToDesktop" to="1" /></keybind>
    <keybind key="W-2"><action name="GoToDesktop" to="2" /></keybind>
    <keybind key="W-3"><action name="GoToDesktop" to="3" /></keybind>
    <keybind key="W-4"><action name="GoToDesktop" to="4" /></keybind>
    <keybind key="W-5"><action name="GoToDesktop" to="5" /></keybind>
    <keybind key="W-C-1"><action name="SendToDesktop" to="1" /></keybind>
    <keybind key="W-C-2"><action name="SendToDesktop" to="2" /></keybind>
    <keybind key="W-C-3"><action name="SendToDesktop" to="3" /></keybind>
    <keybind key="W-C-4"><action name="SendToDesktop" to="4" /></keybind>
    <keybind key="W-C-5"><action name="SendToDesktop" to="5" /></keybind>
    <keybind key="W-u"><action name="GoToDesktop" to="right" wrap="no" /></keybind>
    <keybind key="W-i"><action name="GoToDesktop" to="left" wrap="no" /></keybind>
    <keybind key="W-Next"><action name="GoToDesktop" to="right" wrap="no" /></keybind>
    <keybind key="W-Prior"><action name="GoToDesktop" to="left" wrap="no" /></keybind>
    <keybind key="W-C-u"><action name="SendToDesktop" to="right" wrap="no" /></keybind>
    <keybind key="W-C-i"><action name="SendToDesktop" to="left" wrap="no" /></keybind>
    <keybind key="W-C-Next"><action name="SendToDesktop" to="right" wrap="no" /></keybind>
    <keybind key="W-C-Prior"><action name="SendToDesktop" to="left" wrap="no" /></keybind>

    <keybind key="A-Tab"><action name="NextWindow" /></keybind>
    <keybind key="A-S-Tab"><action name="PreviousWindow" /></keybind>

    <keybind key="W-minus"><action name="ResizeRelative" right="-100" /></keybind>
    <keybind key="W-equal"><action name="ResizeRelative" right="100" /></keybind>
    <keybind key="W-S-minus"><action name="ResizeRelative" bottom="-100" /></keybind>
    <keybind key="W-S-equal"><action name="ResizeRelative" bottom="100" /></keybind>

    <keybind key="Print"><action name="Execute" command="noctalia msg screenshot-region" /></keybind>
    <keybind key="C-Print"><action name="Execute" command="noctalia msg screenshot-fullscreen" /></keybind>

    <keybind key="W-S-e"><action name="Execute" command="uwsm stop" /></keybind>
    <keybind key="C-A-Delete"><action name="Execute" command="uwsm stop" /></keybind>
  </keyboard>

  <mouse>
    <default />
    <context name="All">
      <mousebind direction="W-Down" action="Scroll"><action name="GoToDesktop" to="right" wrap="no" /></mousebind>
      <mousebind direction="W-Up" action="Scroll"><action name="GoToDesktop" to="left" wrap="no" /></mousebind>
    </context>
  </mouse>

  <libinput>
    <device category="non-touch">
      <pointerSpeed>-0.5</pointerSpeed>
    </device>
    <device category="touchpad">
      <naturalScroll>yes</naturalScroll>
      <tap>yes</tap>
    </device>
  </libinput>

  <windowRules>
    <windowRule identifier="at.yrlf.wl_mirror" skipTaskbar="yes" skipWindowSwitcher="yes" ignoreFocusRequest="yes" serverDecoration="no" />
  </windowRules>

</labwc_config>
